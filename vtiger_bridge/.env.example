# ==============================================================================
# CONFIGURACIÓN GOHIGHLEVEL (GHL) & VTIGER CRM (https://www.vtiger.com)
# ==============================================================================

# GoHighLevel (GHL) API Credentials
GHL_API_KEY=tu_token_api_privado_de_ghl_aqui
GHL_LOCATION_ID=tu_location_id_de_ghl_aqui
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# vTiger CRM Connection (Web Services REST API)
# URL de tu instancia (ej: https://tuempresa.od2.vtiger.com o https://crm.tudominio.com)
VTIGER_URL=https://tuempresa.od2.vtiger.com
# Tu nombre de usuario en vTiger (ej: admin o tu_correo@empresa.com)
VTIGER_USERNAME=admin
# Tu Access Key de vTiger (Obtenido en: Mi Perfil > Clave de Acceso / Access Key)
VTIGER_ACCESS_KEY=tu_access_key_alfanumerica_de_vtiger

# Servidor de Sincronización en Tiempo Real (Agente 2)
SYNC_SERVER_HOST=0.0.0.0
SYNC_SERVER_PORT=8000
SYNC_SERVER_SECRET=vtiger_ghl_secure_webhook_secret_2026

# Parámetros del Motor ETL de Migración (Agente 1)
MAX_CONCURRENT_REQUESTS=8
RATE_LIMIT_CALLS_PER_10S=85
BATCH_CHUNK_SIZE=50
RETRY_MAX_ATTEMPTS=5
