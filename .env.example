# ==============================================================================
# LOA ENGINE - PLANTILLA DE ENTORNO (.env.example)
# Multi-Tenant Gateway: 4 Sedes (Palacios, Benavides, Roosevelt, Piura)
# ==============================================================================

PORT=3000
LOA_LICENSE_KEY=LOA-GHL-2026-PROD

# ------------------------------------------------------------------------------
# 1. GOHIGHLEVEL (GHL) - CONFIGURACIÓN MULTI-SEDE (POINT-TO-POINT)
# ------------------------------------------------------------------------------
# ARQUITECTURA DESCENTRALIZADA: se retiró el "GHL Central" (bóveda universal).
# Cada sede se conecta directo a su propia subcuenta con su PIT + Location ID.
# GHL_API_KEY / GHL_LOCATION_ID son el alias de la sede PRIMARIA (Palacios).
GHL_API_KEY=
GHL_LOCATION_ID=

# Sede Palacios (sede primaria)
GHL_API_KEY_PALACIOS=
GHL_LOCATION_ID_PALACIOS=

# Sede Benavides
GHL_API_KEY_BENAVIDES=
GHL_LOCATION_ID_BENAVIDES=

# Sede Roosevelt (standby)
GHL_API_KEY_ROOSEVELT=
GHL_LOCATION_ID_ROOSEVELT=

# Sede Piura (standby)
GHL_API_KEY_PIURA=
GHL_LOCATION_ID_PIURA=

# Custom field "id_form_clipo" (form_id de Meta Lead Ads). El operador lo creó en
# GHL y aparece en la tarjeta del lead. OPCIONAL: si se omite, el motor resuelve el
# ID por nombre vía la API de GHL. El ID determinista por sede vive en
# src/config/meta_forms.js (fuente única).
GHL_FORM_ID_FIELD=
GHL_FORM_ID_FIELD_NAME=id_form_clipo
# Custom field opcional adicional de Meta Ad ID (si el operador crea uno distinto
# a los oficiales por sede en routing_tables.js).
GHL_META_AD_ID_FIELD=


# ------------------------------------------------------------------------------
# 2. META DEVELOPER APIS - CONFIGURACIÓN MULTI-APP & ANTI-CADUCIDAD
# ------------------------------------------------------------------------------
META_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=ghl_meta_secure_token_2026

# Meta App - Sede Palacios
META_APP_ID_PALACIOS=
META_APP_SECRET_PALACIOS=
META_ACCESS_TOKEN_PALACIOS=
META_AD_ACCOUNT_IDS_PALACIOS=

# Meta App - Sede Benavides
META_APP_ID_BENAVIDES=
META_APP_SECRET_BENAVIDES=
META_ACCESS_TOKEN_BENAVIDES=
META_AD_ACCOUNT_IDS_BENAVIDES=

# Meta App - Sede Roosevelt
META_APP_ID_ROOSEVELT=
META_APP_SECRET_ROOSEVELT=
META_ACCESS_TOKEN_ROOSEVELT=
META_AD_ACCOUNT_IDS_ROOSEVELT=

# Meta App - Sede Piura
META_APP_ID_PIURA=
META_APP_SECRET_PIURA=
META_ACCESS_TOKEN_PIURA=
META_AD_ACCOUNT_IDS_PIURA=

# Pool de Tokens de Contingencia / System Users (Separados por coma)
META_BACKUP_TOKENS=


# ------------------------------------------------------------------------------
# 3. VTIGER CRM CONNECTION SETTINGS
# ------------------------------------------------------------------------------
VTIGER_URL=https://ventascallcenter.com
VTIGER_USERNAME=GABRIEL
VTIGER_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 4. COLAS DURABLES Y ESTADO DISTRIBUIDO (FEATURE FLAG)
# ------------------------------------------------------------------------------
# QUEUE_DRIVER=memory  -> cola en proceso (cero dependencias externas)
# QUEUE_DRIVER=bullmq  -> BullMQ + Redis: reintentos exponenciales, DLQ y
#                         rate-limiting distribuido entre instancias.
QUEUE_DRIVER=memory
REDIS_URL=

# Persistencia stateless de cursores / learning_brain:
# PERSISTENCE_DRIVER=file | postgres (requiere DATABASE_URL)
PERSISTENCE_DRIVER=file
DATABASE_URL=

# Presupuesto máximo del Pre-Flight Sanity Check en arranque (ms).
# Render mata el deploy si el sanity check excede este presupuesto.
PREFLIGHT_MAX_MS=5000

# ------------------------------------------------------------------------------
# 5. NIVELES DE SINCRONIZACIÓN (N2 en dos carriles + N3 reactivo)
# ------------------------------------------------------------------------------
# N2A = histórico (cobertura) · N2B = reconciliación (completitud).
# El reparto de turnos entre carriles es automático; no requiere variables.

# Nivel 3 — sincronización reactiva de vTiger (un cambio = una ficha completa).
# Se activa por defecto; el demonio inverso antiguo queda apagado.
VTIGER_REVERSE_SYNC_ENABLED=false
# Cada cuánto se buscan cambios en vTiger (ms).
NIVEL3_INTERVALO_MS=60000
# Contactos por sede y por ciclo del tail (carril reactivo, no masivo).
NIVEL3_LOTE=10
# Tope diario de contactos sincronizados por el Nivel 3 (protege la cuota de N1/N2A).
# Medición del delta real de vTiger: 39.504 cambios/24 h (9.436 de compradores).
NIVEL3_MAX_DIA=20000
# Si el cambio pendiente más viejo supera este atraso (min), el cursor salta al
# presente: el carril es reactivo y el histórico lo cubre N2A.
NIVEL3_MAX_ATRASO_MIN=45
# false = sincroniza TODO lo que cambia en vTiger (contactos y compradores), que es
# el objetivo: tener los CF de vTiger reflejados. true = solo compradores.
NIVEL3_SOLO_COMPRADORES=false
# Un mismo contacto editado varias veces en N minutos se sincroniza UNA vez.
NIVEL3_COOLDOWN_MIN=10
# Sincronizaciones simultáneas del Nivel 3.
NIVEL3_CONCURRENCIA=2

# ------------------------------------------------------------------------------
# 6. CONTROL POR SUBCUENTA (4 workers independientes + efectividad por contacto)
# ------------------------------------------------------------------------------
# Cada sede tiene su cola, su cuota y su libro. Reintentos antes de marcar fallido.
CONTROL_MAX_INTENTOS=3
# Tope de cola por sede (protege memoria).
CONTROL_MAX_COLA=5000
# Pausa entre tareas del worker (ms) y frecuencia de vigilancia de la cola.
CONTROL_PAUSA_MS=150
CONTROL_VIGILANCIA_MS=15000
# Ración de lecturas a vTiger por sede y por minuto (además del gate global de 3).
VTIGER_LECTURAS_POR_MIN_SEDE=60

# ------------------------------------------------------------------------------
# 7. ESPEJO vTiger → GHL
# ------------------------------------------------------------------------------
# true (por defecto): se publica el ESTADO ACTUAL de vTiger. Una corrección en el
# CRM (compra anulada 3→1, fecha corregida) SÍ se refleja en GHL.
# false: filtro monótono antiguo (sólo avanza fechas/contadores; nunca retrocede).
# En ambos modos se protege un contador positivo de un 0 (spl_num_compras=0 es un
# centinela de "no calculado", no una corrección real).
GHL_MODO_ESPEJO=true

# ------------------------------------------------------------------------------
# 8. AHORRO DE CUOTA — SCANNERS Y RUTEO (medido 27/11: 9.920 llamadas/hora)
# ------------------------------------------------------------------------------
# Radar (scanner de conversaciones). Antes cada 5 s: releía 60 contactos + 100
# conversaciones por sede en cada pasada aunque no hubiera mensajes nuevos.
# 60 s por defecto; RADAR_ENABLED=false lo apaga del todo (el webhook sigue ruteando).
RADAR_ENABLED=true
RADAR_INTERVALO_MS=60000
# Trabajo del día (refresco de UTM/Ad ID de hoy). Antes 3 min; ahora 15.
TRABAJO_DIA_ENABLED=true
TRABAJO_DIA_MS=900000
# Guardián de bandejas "sin asignar": con los dueños disueltos re-ruteaba trabajo
# ya hecho. Apagado por defecto.
GUARDIAN_BANDEJAS_ENABLED=false
# Curador bidireccional (recorre GHL contacto por contacto). Redundante con el
# Nivel 3 reactivo: se deja como reconciliación lenta.
CURADOR_BIDIRECCIONAL_ENABLED=true
CURADOR_FORWARD_MS=900000
CURADOR_BACKWARD_MS=1800000
# Pedir historial de órdenes sólo a quien tiene compras (ahorra 1-3 llamadas por lead).
ORDER_HISTORY_SOLO_COMPRADORES=true

# ------------------------------------------------------------------------------
# 9. FRONTERA N1 (HOY) / N2 (HISTÓRICO)
# ------------------------------------------------------------------------------
# true (por defecto): el Nivel 2 recorre SOLO lo anterior a hoy (hora Lima). Los
# contactos de hoy los atiende el Nivel 1 y el Nivel 3 reactivo.
# false: el backfill histórico también recorre el día de hoy.
N2_HASTA_AYER=true

# Endurece el arranque: en local/CI puede exigir el 100% de los secretos.
# NUNCA activar en Render (provoca crash loop).
STRICT_CONFIG=false
NODE_ENV=development
