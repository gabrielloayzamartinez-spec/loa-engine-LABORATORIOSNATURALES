# ==============================================================================
# LOA ENGINE - PLANTILLA DE ENTORNO (.env.example)
# Multi-Tenant Gateway: 4 Sedes (Palacios, Benavides, Roosevelt, Piura)
# ==============================================================================

PORT=3000
LOA_LICENSE_KEY=LOA-GHL-2026-PROD

# ------------------------------------------------------------------------------
# 1. GOHIGHLEVEL (GHL) - CONFIGURACIÓN MULTI-SEDE (POINT-TO-POINT)
# ------------------------------------------------------------------------------
# ARQUITECTURA DESCENTRALIZADA: se retiró el "GHL Central" (bóveda universal).
# Cada sede se conecta directo a su propia subcuenta con su PIT + Location ID.
# GHL_API_KEY / GHL_LOCATION_ID son el alias de la sede PRIMARIA (Palacios).
GHL_API_KEY=
GHL_LOCATION_ID=

# Sede Palacios (sede primaria)
GHL_API_KEY_PALACIOS=
GHL_LOCATION_ID_PALACIOS=

# Sede Benavides
GHL_API_KEY_BENAVIDES=
GHL_LOCATION_ID_BENAVIDES=

# Sede Roosevelt (standby)
GHL_API_KEY_ROOSEVELT=
GHL_LOCATION_ID_ROOSEVELT=

# Sede Piura (standby)
GHL_API_KEY_PIURA=
GHL_LOCATION_ID_PIURA=


# ------------------------------------------------------------------------------
# 2. META DEVELOPER APIS - CONFIGURACIÓN MULTI-APP & ANTI-CADUCIDAD
# ------------------------------------------------------------------------------
META_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=ghl_meta_secure_token_2026

# Meta App - Sede Palacios
META_APP_ID_PALACIOS=
META_APP_SECRET_PALACIOS=
META_ACCESS_TOKEN_PALACIOS=
META_AD_ACCOUNT_IDS_PALACIOS=

# Meta App - Sede Benavides
META_APP_ID_BENAVIDES=
META_APP_SECRET_BENAVIDES=
META_ACCESS_TOKEN_BENAVIDES=
META_AD_ACCOUNT_IDS_BENAVIDES=

# Meta App - Sede Roosevelt
META_APP_ID_ROOSEVELT=
META_APP_SECRET_ROOSEVELT=
META_ACCESS_TOKEN_ROOSEVELT=
META_AD_ACCOUNT_IDS_ROOSEVELT=

# Meta App - Sede Piura
META_APP_ID_PIURA=
META_APP_SECRET_PIURA=
META_ACCESS_TOKEN_PIURA=
META_AD_ACCOUNT_IDS_PIURA=

# Pool de Tokens de Contingencia / System Users (Separados por coma)
META_BACKUP_TOKENS=


# ------------------------------------------------------------------------------
# 3. VTIGER CRM CONNECTION SETTINGS
# ------------------------------------------------------------------------------
VTIGER_URL=https://ventascallcenter.com
VTIGER_USERNAME=GABRIEL
VTIGER_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 4. COLAS DURABLES Y ESTADO DISTRIBUIDO (FEATURE FLAG)
# ------------------------------------------------------------------------------
# QUEUE_DRIVER=memory  -> cola en proceso (cero dependencias externas)
# QUEUE_DRIVER=bullmq  -> BullMQ + Redis: reintentos exponenciales, DLQ y
#                         rate-limiting distribuido entre instancias.
QUEUE_DRIVER=memory
REDIS_URL=

# Persistencia stateless de cursores / learning_brain:
# PERSISTENCE_DRIVER=file | postgres (requiere DATABASE_URL)
PERSISTENCE_DRIVER=file
DATABASE_URL=

# Presupuesto máximo del Pre-Flight Sanity Check en arranque (ms).
# Render mata el deploy si el sanity check excede este presupuesto.
PREFLIGHT_MAX_MS=5000

# Endurece el arranque: en local/CI puede exigir el 100% de los secretos.
# NUNCA activar en Render (provoca crash loop).
STRICT_CONFIG=false
NODE_ENV=development
